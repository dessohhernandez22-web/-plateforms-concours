# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# URL publique canonique (HTTPS en production). Utilisée pour les métadonnées,
# le sitemap, les liens de réinitialisation et les retours de paiement.
NEXT_PUBLIC_APP_URL="https://your-domain.example"
NEXTAUTH_URL="https://your-domain.example"
AUTH_URL="https://your-domain.example"
# Adresse de contact affichée dans les pages légales et le pied de page.
NEXT_PUBLIC_CONTACT_EMAIL="contact@your-domain.example"

# Générez chaque secret avec : openssl rand -base64 48
AUTH_SECRET="change-me"
NEXTAUTH_SECRET="change-me"

# Obligatoire en production (32 caractères minimum) : chiffrement des données
# personnelles des mineurs et des coordonnées sensibles.
PII_ENCRYPTION_KEY="change-this-to-a-long-random-secret"

# Sel utilisé pour pseudonymiser les adresses IP et empreintes d'appareils.
RATE_LIMIT_SECRET="change-this-to-a-long-random-secret"

# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
# En local, `npm run dev` démarre une base PostgreSQL embarquée.
# En production (Neon, Supabase, etc.) :
#   DATABASE_URL = URL poolée (avec -pooler) pour l'exécution
#   DIRECT_URL   = URL directe (sans -pooler) pour les migrations
DATABASE_URL="postgresql://plateforme:plateforme@localhost:5432/plateforme?schema=public"
DIRECT_URL="postgresql://plateforme:plateforme@localhost:5432/plateforme?schema=public"

# ---------------------------------------------------------------------------
# Premier administrateur (créé par `npm run db:seed`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@your-domain.example"
ADMIN_PASSWORD="change-this-to-a-strong-password"
ADMIN_NAME="Administrateur"

# ---------------------------------------------------------------------------
# Stockage des médias
# ---------------------------------------------------------------------------
# "local" en développement, "blob" en production (Vercel Blob).
NEXT_PUBLIC_UPLOAD_MODE="local"
BLOB_READ_WRITE_TOKEN=""
# Répertoire des fichiers en mode local (facultatif).
# UPLOAD_DIR="/chemin/absolu/vers/uploads"

# ---------------------------------------------------------------------------
# E-mail transactionnel
# ---------------------------------------------------------------------------
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_FROM="SPP Concours <no-reply@your-domain.example>"

# ---------------------------------------------------------------------------
# Paiement Saspay
# ---------------------------------------------------------------------------
SASPAY_API_BASE_URL="https://api.saspay.me/api/v1"
SASPAY_API_KEY="your-saspay-api-key"
SASPAY_WEBHOOK_SECRET="your-saspay-webhook-signing-secret"
SASPAY_WEBHOOK_URL="https://your-domain.example/api/saspay/callback"

# ---------------------------------------------------------------------------
# Tâches planifiées
# ---------------------------------------------------------------------------
# Générez avec : openssl rand -hex 32
CRON_SECRET="change-this-to-a-random-secret"
